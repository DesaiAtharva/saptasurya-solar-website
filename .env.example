# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Lead storage (Supabase — shared with the CRM app) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Email alert on every new lead (resend.com, free tier) ---
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=you@example.com
# Needs a verified domain in Resend; leave empty to use Resend's test sender
LEAD_FROM_EMAIL=Saptasurya Leads <leads@saptasuryasolar.com>

# --- Instant phone alert via Telegram bot (free) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analytics / ads (public) ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# e.g. AW-123456789/AbCdEfGh
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=
NEXT_PUBLIC_META_PIXEL_ID=
